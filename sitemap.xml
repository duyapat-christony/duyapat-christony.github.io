---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.sitemaps.org/schemas/sitemap/0.9 http://www.sitemaps.org/schemas/sitemap/0.9/sitemap.xsd" xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>https://duyapat-christony.github.io</loc>
    <priority>1.0</priority>
  </url>

  {% for tab in site.tabs %}
    <url>
      <loc>{{ site.url }}{{ tab.url }}</loc>

      {% if tab.sitemap.priority == null %}
        <priority>0.8</priority>
      {% else %}
        <priority>{{ tab.sitemap.priority }}</priority>
      {% endif %}
    </url>
  {% endfor %}

  {% for student in site.for-students %}
    <url>
      <loc>{{ site.url }}{{ student.url }}</loc>

      {% if student.sitemap.priority == null %}
        <priority>0.5</priority>
      {% else %}
        <priority>{{ student.sitemap.priority }}</priority>
      {% endif %}
    </url>
  {% endfor %}

  {% for post in site.posts %}
    <url>
      <loc>{{ site.url }}{{ post.url }}</loc>

      {% if post.sitemap.priority == null %}
        <priority>0.5</priority>
      {% else %}
        <priority>{{ post.sitemap.priority }}</priority>
      {% endif %}
    </url>
  {% endfor %}
</urlset>

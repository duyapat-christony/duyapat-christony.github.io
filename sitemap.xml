---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.sitemaps.org/schemas/sitemap/0.9 http://www.sitemaps.org/schemas/sitemap/0.9/sitemap.xsd" xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>https://duyapat-christony.github.io</loc>
    <priority>1.0</priority>
  </url>
  <url>
    <loc>https://duyapat-christony.github.io/for-students/</loc>
    <priority>0.8</priority>
  </url>
  <url>
    <loc>https://duyapat-christony.github.io/data-analytics/</loc>
    <priority>0.8</priority>
  </url>
  <url>
    <loc>https://duyapat-christony.github.io/about/</loc>
    <priority>0.8</priority>
  </url>
  <url>
    <loc>https://duyapat-christony.github.io/categories/</loc>
    <priority>0.8</priority>
  </url>
  <url>
    <loc>https://duyapat-christony.github.io/tags/</loc>
    <priority>0.8</priority>
  </url>
  <url>
    <loc>https://duyapat-christony.github.io/archives/</loc>
    <priority>0.8</priority>
  </url>

  {% for student in site.for-students %}
    <url>
      <loc>{{ site.url }}{{ student.url }}</loc>
      {% if student.lastmod == null %}
        <lastmod>{{ student.date | date_to_xmlschema }}</lastmod>
      {% else %}
        <lastmod>{{ student.lastmod | date_to_xmlschema }}</lastmod>
      {% endif %}

      {% if student.sitemap.changefreq == null %}
        <changefreq>weekly</changefreq>
      {% else %}
        <changefreq>{{ student.sitemap.changefreq }}</changefreq>
      {% endif %}

      {% if student.sitemap.priority == null %}
        <priority>0.5</priority>
      {% else %}
        <priority>{{ student.sitemap.priority }}</priority>
      {% endif %}
    </url>
  {% endfor %}

  {% for post in site.posts %}
    <url>
      <loc>{{ site.url }}{{ post.url }}</loc>
      {% if post.lastmod == null %}
        <lastmod>{{ post.date | date_to_xmlschema }}</lastmod>
      {% else %}
        <lastmod>{{ post.lastmod | date_to_xmlschema }}</lastmod>
      {% endif %}

      {% if post.sitemap.changefreq == null %}
        <changefreq>weekly</changefreq>
      {% else %}
        <changefreq>{{ post.sitemap.changefreq }}</changefreq>
      {% endif %}

      {% if post.sitemap.priority == null %}
        <priority>0.5</priority>
      {% else %}
        <priority>{{ post.sitemap.priority }}</priority>
      {% endif %}
    </url>
  {% endfor %}
</urlset>
